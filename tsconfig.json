{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "docs/contracts.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "tests",
    "playwright.journey.config.ts",
    "playwright.production.config.ts",
    "vitest.config.ts",
    "playwright.phase4*.ts",
    "playwright.compact*.ts",
    "playwright.module*.ts",
    "playwright.course-reference*.ts",
    "playwright.four-modules*.ts",
    "playwright.lesson-entry*.ts",
    "playwright.sidebar-height*.ts",
    "playwright.compact-reading*.ts",
    "playwright.content-frame*.ts",
    "playwright.separated-panels*.ts",
    "playwright.blue-objectives*.ts",
    "playwright.support-study*.ts",
    "playwright.figures-guide*.ts"
  ]
}
