{
  "name": "edu-environment",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:goals": "playwright test --config=playwright.goals.config.ts",
    "test": "vitest run",
    "build:demo": "npm run typecheck && vite build --mode demo",
    "build:e2e": "npm run typecheck && vite build --mode e2e",
    "test:journey": "playwright test --config=playwright.journey.config.ts",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "content:manifest": "node scripts/write-content-manifest.mjs",
    "test:phase4": "playwright test --config=playwright.phase4.config.ts",
    "test:phase4:journey": "playwright test --config=playwright.phase4.journey.config.ts",
    "test:phase4:production": "playwright test --config=playwright.phase4.production.config.ts",
    "test:compact": "playwright test --config=playwright.compact.config.ts",
    "test:compact:regression": "playwright test --config=playwright.compact-regression.config.ts",
    "test:compact:journey": "playwright test --config=playwright.compact-validation.config.ts",
    "test:compact:production": "playwright test --config=playwright.compact-production.config.ts",
    "test:module": "playwright test --config=playwright.module.config.ts",
    "test:module:regression": "playwright test --config=playwright.module-regression.config.ts",
    "test:module:journey": "playwright test --config=playwright.module-validation.config.ts",
    "test:module:production": "playwright test --config=playwright.module-production.config.ts",
    "test:module:public": "playwright test --config=playwright.module-public.config.ts",
    "test:open-learning": "playwright test --config=playwright.open-learning.config.ts",
    "test:open-learning:production": "playwright test --config=playwright.open-learning-production.config.ts",
    "course:manifest": "node scripts/write-course-reference-manifest.mjs",
    "test:course": "playwright test --config=playwright.course-reference.config.ts",
    "test:course:production": "playwright test --config=playwright.course-reference-production.config.ts",
    "test:four-modules": "playwright test --config=playwright.four-modules.config.ts",
    "test:four-modules:production": "playwright test --config=playwright.four-modules-production.config.ts",
    "test:lesson-entry": "playwright test --config=playwright.lesson-entry.config.ts",
    "test:sidebar-height": "playwright test --config=playwright.sidebar-height.config.ts",
    "test:compact-reading": "playwright test --config=playwright.compact-reading.config.ts",
    "test:content-frame": "playwright test --config=playwright.content-frame.config.ts",
    "test:support-study": "playwright test --config=playwright.support-study.config.ts",
    "test:support-study:production": "playwright test --config=playwright.support-study-production.config.ts",
    "test:blue-objectives": "playwright test --config=playwright.blue-objectives.config.ts",
    "test:separated-panels": "playwright test --config=playwright.separated-panels.config.ts",
    "test:figures-guide": "playwright test --config=playwright.figures-guide.config.ts",
    "test:figures-guide:production": "playwright test --config=playwright.figures-guide-production.config.ts",
    "test:module-actions": "playwright test --config=playwright.module-actions.config.ts",
    "test:module-actions:production": "playwright test --config=playwright.module-actions-production.config.ts",
    "test:mobile-flow": "playwright test --config=playwright.mobile-flow.config.ts",
    "test:mobile-flow:production": "playwright test --config=playwright.mobile-flow-production.config.ts"
  },
  "dependencies": {
    "@fontsource/cairo": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
